# Frontend: where the API lives. Locally the backend runs on its own port;
# in production (same Vercel project) this can just be "/api".
VITE_API_BASE_URL=http://localhost:8787/api

# Backend (api-src/, run locally via `npm run dev:api`; on Vercel these are
# set as project environment variables instead of a .env file).
# "direct" = v3.football.api-sports.io (key from your API-Sports dashboard)
# "rapidapi" = api-football-v1.p.rapidapi.com (key from your RapidAPI subscription)
API_FOOTBALL_MODE=direct
API_FOOTBALL_KEY=replace-me

# UEFA Champions League = 2
API_FOOTBALL_LEAGUE_ID=2
# Season is the year it started, e.g. 2026 for the 2026/2027 season
API_FOOTBALL_SEASON=2026

PORT=8787
CORS_ORIGIN=http://localhost:5173
